# PostgreSQL connection string
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/men_stimulation
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of the site (used for payment redirects and webhooks)
SITE_URL=http://localhost:3000

# Mollie: test_... for development, live_... in production
MOLLIE_API_KEY=

# Resend (leave empty: emails are logged to the console instead)
RESEND_API_KEY=
EMAIL_FROM="Shop <orders@example.com>"

# Optional: password-protect the whole site (e.g. for a shared preview). Empty = off.
PREVIEW_PASSWORD=
